<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="S8_P4.MainPage"
             BackgroundColor="#F3F0FF">
    
    <StackLayout Padding="30" Spacing="15">

        <Label Text="Calculadora de Dos Números"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="#512BD4"
               HorizontalOptions="Center" />

        <Entry x:Name="txtNumero1"
               Placeholder="Número 1"
               Keyboard="Numeric"
               FontSize="18"
               TextColor="Black"
               PlaceholderColor="Gray" />

        <Entry x:Name="txtNumero2"
               Placeholder="Número 2"
               Keyboard="Numeric"
               FontSize="18"
               TextColor="Black"
               PlaceholderColor="Gray" />

        <Button Text="Sumar"
                Clicked="Sumar_Clicked"
                BackgroundColor="#512BD4"
                TextColor="White" />

        <Button Text="Restar"
                Clicked="Restar_Clicked"
                BackgroundColor="#2B7BD4"
                TextColor="White" />

        <Button Text="Multiplicar"
                Clicked="Multiplicar_Clicked"
                BackgroundColor="#2BA84A"
                TextColor="White" />

        <Button Text="Dividir"
                Clicked="Dividir_Clicked"
                BackgroundColor="#D47A2B"
                TextColor="White" />

        <Label x:Name="lblResultado"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="#333333"
               HorizontalOptions="Center" />
    </StackLayout>
</ContentPage>